{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "guardianTask",
      "type": "promptString",
      "description": "Project Guardian task summary"
    },
    {
      "id": "guardianQuestion",
      "type": "promptString",
      "description": "Question for Project Guardian"
    }
  ],
  "tasks": [
    {
      "label": "Project Guardian: Verify",
      "type": "shell",
      "command": "guardian-cmd guardian-verify",
      "problemMatcher": []
    },
    {
      "label": "Project Guardian: Update Memory",
      "type": "shell",
      "command": "guardian-cmd guardian-update \"${input:guardianTask}\"",
      "problemMatcher": []
    },
    {
      "label": "Project Guardian: Brief",
      "type": "shell",
      "command": "guardian-cmd guardian-brief \"${input:guardianQuestion}\"",
      "problemMatcher": []
    },
    {
      "label": "Project Guardian: Query",
      "type": "shell",
      "command": "guardian-cmd guardian-query \"${input:guardianQuestion}\" --limit 3",
      "problemMatcher": []
    },
    {
      "label": "Project Guardian: Handover",
      "type": "shell",
      "command": "guardian-cmd guardian-handover",
      "problemMatcher": []
    }
  ]
}
