{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "guardianTask",
      "type": "promptString",
      "description": "Project Guardian 任务摘要"
    },
    {
      "id": "guardianQuestion",
      "type": "promptString",
      "description": "要查询的 Project Guardian 问题"
    }
  ],
  "tasks": [
    {
      "label": "Project Guardian: Verify",
      "type": "shell",
      "command": "guardian verify",
      "problemMatcher": []
    },
    {
      "label": "Project Guardian: Update Memory",
      "type": "shell",
      "command": "guardian update \"${input:guardianTask}\"",
      "problemMatcher": []
    },
    {
      "label": "Project Guardian: Brief",
      "type": "shell",
      "command": "guardian brief \"${input:guardianQuestion}\"",
      "problemMatcher": []
    },
    {
      "label": "Project Guardian: Query",
      "type": "shell",
      "command": "guardian query \"${input:guardianQuestion}\" --limit 3",
      "problemMatcher": []
    },
    {
      "label": "Project Guardian: Handover",
      "type": "shell",
      "command": "guardian handover",
      "problemMatcher": []
    }
  ]
}
